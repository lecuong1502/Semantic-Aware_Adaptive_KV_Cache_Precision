graduation_thesis/
.venv/
# Build artifacts
build/
dist/
*.egg-info/
_skbuild/
__pycache__/
*.py[cod]
*.so
.pytest_cache/

# Model weights: downloaded, never committed. See CONTRIBUTING.
models/

# The golden tensor generator lives in its own environment: it is the only
# place torch may appear, and it must never sit beside the engine (ADR-0002).
.venv-golden/

# Golden reference tensors: 242 MiB across both models, and git keeps every
# regeneration forever. Stored on disk, not in history. See ADR-0002.
tests/golden/

# Nsight Compute reports: binary, about 30 MiB each, and regenerated by one
# command (studies/gemm/profile.py ncu-command). The JSON summarised from each,
# with its commit and hardware, is what is committed.
*.ncu-rep

# Held-out evaluation text, fetched by the tool that uses it and checked
# against a pinned hash there (tools/perplexity.py). Not ours to redistribute.
data/
